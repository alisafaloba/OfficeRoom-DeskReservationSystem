<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-11-10-15-00-create-resources" author="template">

        <!-- 1. Equipment Catalogue -->
        <createTable tableName="equipment_catalogue">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- Audit columns from BaseEntity -->
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint">
                <constraints nullable="false"/>
            </column>

            <column name="name" type="varchar(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_equipment_name"/>
            </column>
        </createTable>

        <!-- Seeding the catalogue. Since UUIDs and audit columns are NOT null, we must provide them -->
        <insert tableName="equipment_catalogue">
            <column name="id" value="11111111-1111-1111-1111-111111111111"/>
            <column name="created_at" valueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueDate="CURRENT_TIMESTAMP"/>
            <column name="version" valueNumeric="0"/>
            <column name="name" value="monitor"/>
        </insert>
        <insert tableName="equipment_catalogue">
            <column name="id" value="22222222-2222-2222-2222-222222222222"/>
            <column name="created_at" valueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueDate="CURRENT_TIMESTAMP"/>
            <column name="version" valueNumeric="0"/>
            <column name="name" value="docking station"/>
        </insert>
        <insert tableName="equipment_catalogue">
            <column name="id" value="33333333-3333-3333-3333-333333333333"/>
            <column name="created_at" valueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueDate="CURRENT_TIMESTAMP"/>
            <column name="version" valueNumeric="0"/>
            <column name="name" value="projector"/>
        </insert>
        <insert tableName="equipment_catalogue">
            <column name="id" value="44444444-4444-4444-4444-444444444444"/>
            <column name="created_at" valueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueDate="CURRENT_TIMESTAMP"/>
            <column name="version" valueNumeric="0"/>
            <column name="name" value="whiteboard"/>
        </insert>
        <insert tableName="equipment_catalogue">
            <column name="id" value="55555555-5555-5555-5555-555555555555"/>
            <column name="created_at" valueDate="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueDate="CURRENT_TIMESTAMP"/>
            <column name="version" valueNumeric="0"/>
            <column name="name" value="video conferencing"/>
        </insert>

        <!-- 2. Resources Table -->
        <createTable tableName="resources">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- Audit columns from BaseEntity -->
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint">
                <constraints nullable="false"/>
            </column>

            <column name="floor_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_resources_floor" referencedTableName="floors" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="label" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="capacity" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="text"/>
            <column name="status" type="varchar(50)"/>
        </createTable>

        <addUniqueConstraint tableName="resources" columnNames="floor_id, label" constraintName="uq_resources_label_per_floor"/>

        <!-- 3. Join Table for Resource <-> Equipment -->
        <createTable tableName="resource_equipment">
            <column name="resource_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_req_resource" referencedTableName="resources" referencedColumnNames="id"/>
            </column>
            <column name="equipment_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_req_equipment" referencedTableName="equipment_catalogue" referencedColumnNames="id"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="resource_equipment" columnNames="resource_id, equipment_id" constraintName="pk_resource_equipment"/>
    </changeSet>

</databaseChangeLog>