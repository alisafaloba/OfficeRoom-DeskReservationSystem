<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- The colleagues invited to a meeting-room booking (E5.T1). A plain join table: a row
         goes with its booking and with its user (ON DELETE CASCADE). -->
    <changeSet id="2026-11-21-12-10-create-booking-attendees" author="klooseduard95">
        <createTable tableName="booking_attendees">
            <column name="booking_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_booking_attendees_booking"
                             references="bookings(id)"
                             deleteCascade="true"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_booking_attendees_user"
                             references="users(id)"
                             deleteCascade="true"/>
            </column>
        </createTable>
        <!-- One row per attendee per booking; the key also serves lookups by booking. -->
        <addPrimaryKey tableName="booking_attendees" columnNames="booking_id, user_id"
                       constraintName="pk_booking_attendees"/>
        <!-- "Meetings I'm invited to" and the users(id) cascade. -->
        <createIndex tableName="booking_attendees" indexName="ix_booking_attendees_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
